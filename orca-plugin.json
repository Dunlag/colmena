{
  "manifestVersion": 2,
  "id": "colmena",
  "name": "Colmena",
  "version": "0.1.0",
  "description": "Cola de Bob, bots, workers y automatizaciones de Orca por máquina.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "commands": [
      {
        "id": "colmena.abrir",
        "title": "Abrir colmena",
        "when": "workspace"
      }
    ],
    "customEditors": [
      {
        "id": "colmena",
        "title": "Colmena",
        "extensions": [".colmena"],
        "entry": "src/pestana.html"
      }
    ],
    "panels": [
      {
        "id": "colmena",
        "title": "Colmena",
        "icon": "blocks",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      },
      {
        "on": "workspace.created"
      },
      {
        "on": "workspace.removed"
      },
      {
        "on": "workspace.changed"
      }
    ],
    "hooks": [
      {
        "event": "agent.launch.before",
        "onError": "pass"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "storage:own"
    }
  ]
}
